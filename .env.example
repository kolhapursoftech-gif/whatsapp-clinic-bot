# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose_any_random_string_here
WHATSAPP_API_VERSION=v20.0

# --- Groq (optional AI fallback for free-text help messages) ---
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# --- Google Sheets ---
GOOGLE_SHEET_ID=your_sheet_id_from_the_url
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# Paste the private_key from the downloaded JSON, keeping \n escapes as-is
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# --- Doctor notifications ---
DOCTOR_WHATSAPP_NUMBER=91xxxxxxxxxx

# --- Clinic info ---
CLINIC_NAME=Your Clinic Name

# --- Server ---
PORT=3000
# Shared secret so only your missed-call trigger can hit /trigger-missed-call
TRIGGER_SECRET=choose_any_random_string_here
